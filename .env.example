# Copy to .env and fill in. Never commit .env.

# Meterless Nightshift runtime (OpenAI-compatible)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your_token_here
# Nightshift lanes (Nightshift app -> Lanes). MODEL_* is what is sent in the request (a lane id, or a full
# model id); *_EXPECTED is the Nemotron model that must actually answer. The trace records whether it did.
MODEL_ANALYST=vidhur-analyst
MODEL_ANALYST_EXPECTED=nvidia/nemotron-3.5-lightning-30b-a3b
# vidhur-evaluator could not be pinned to a larger Nemotron (check with scripts/check_lanes.py), so the
# Planner and Evaluator use the analyst lane on purpose.
MODEL_EVALUATOR=vidhur-analyst
MODEL_EVALUATOR_EXPECTED=nvidia/nemotron-3.5-lightning-30b-a3b

# Zetaris (local Docker, REST API on 8888 - not 8889)
ZETARIS_API_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_USER=your_user
ZETARIS_PASSWORD=your_password
# Optional: Docker container whose volume Zetaris reads files from
# ZETARIS_DRIVER_CONTAINER=zetaris-driver-1

# Optional Vidhur settings
# NEWS_CACHE_MAX_AGE_HOURS=24
# EVIDENCE_MAX_AGE_DAYS=30
# LLM_MAX_ATTEMPTS=5

# Docker: inside a container "localhost" is the container itself. When VIDHUR_IN_DOCKER=1 (the Dockerfile sets it; /.dockerenv is
# also detected) Vidhur rewrites localhost / 127.0.0.1 in METERLESS_BASE_URL and ZETARIS_API_URL to host.docker.internal, so the
# same .env works locally and in Docker. Run: docker run --rm --env-file .env vidhur python scripts/healthcheck.py
# DOCKER_HOST_ALIAS=host.docker.internal
# VIDHUR_IN_DOCKER=1
